# Uncompressed language model left behind when building public/tesseract/
# eng.traineddata.gz. 3.9 MB, unreferenced, and not what the worker fetches.
/eng.traineddata

# tesseract.js runtime, copied from node_modules by server/ocrAssets.ts.
# public/tesseract/eng.traineddata.gz is committed: it is not an npm artefact.
public/tesseract/worker.min.js
public/tesseract/tesseract-core-*.wasm.js

